# OpenAI
OPENAI_API_KEY=

# Elasticsearch
ES_HOST=http://elasticsearch:9200
ES_INDEX_NAME=documents

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
MEMORY_TTL_SECONDS=3600

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Models
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval / reranking
RERANK_TOP_K=10
FINAL_TOP_K=3
